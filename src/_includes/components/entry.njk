{% from "components/language.njk" import languageBadge %}
{% macro listEntry(entry, showLinks=false) %}
<article class="entry">
  <div class="entry-thumbnail">
    <img class="entry-image" src="{{ entry.data.image or '/assets/favicon.svg' }}" alt="{{ entry.data.imageAlt or '' }}" loading="lazy" decoding="async">
  </div>
  <div class="entry-content">
    <h2>{% if entry.url %}<a href="{{ entry.url }}">{{ entry.data.title }}</a>{% else %}{{ entry.data.title }}{% endif %} {{ languageBadge(entry.data.lang or 'en-GB') }}</h2>
    <time class="entry-date" datetime="{{ entry.date | isoDate }}">{{ entry.date | shortDate }}</time>
    {% if showLinks and not entry.url %}{% set links = entry.data.links %}{% include 'project-links.njk' %}{% endif %}
  </div>
</article>
{% endmacro %}
