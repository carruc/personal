---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"><channel>
<title>{{ site.name }} — Articles</title><link>{{ site.url }}/articles/</link><description>{{ site.description }}</description><language>en-GB</language>
{% for entry in collections.articles %}{% if not entry.data.draft %}<item><title>{{ entry.data.title }}</title><link>{{ entry.url | absolute(site.url) }}</link><guid>{{ entry.url | absolute(site.url) }}</guid><description>{{ entry.data.summary }}</description><pubDate>{{ entry.date | dateToRfc822 }}</pubDate></item>{% endif %}{% endfor %}
</channel></rss>
